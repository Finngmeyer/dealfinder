# Copy to .env and fill in what you have. Every key is optional: a missing key turns that
# feature off with a clear message, and nothing crashes.

# Listings and rent estimates (Phase 3+). Free plan: 50 requests a month.
RENTCAST_API_KEY=

# Free government data (Phase 2)
HUD_API_TOKEN=
CENSUS_API_KEY=
# Optional: without it the keyless FRED CSV is used.
FRED_API_KEY=

# Optional listing-description parsing (Phase 4)
ANTHROPIC_API_KEY=

# Optional scraper adapter, off by default (Phase 6)
APIFY_TOKEN=

# Alerts (Phase 6): any one of these is enough
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Optional: the From address. Defaults to SMTP_USERNAME.
ALERT_EMAIL_FROM=

# Paths (defaults shown)
DEALFINDER_CONFIG_DIR=config
DEALFINDER_DATA_DIR=data
DEALFINDER_DB_URL=sqlite:///data/dealfinder.db
